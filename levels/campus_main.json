      "dialog": {
        "chains": [
          {
            "chain_id": "intro",
            "lines": [
              "New semester already.",
              "Fifteen credits is the ceiling,",
              "and the ceiling does not move."
            ],
            "emotion": "neutral"
          },
          {
            "chain_id": "firewall",
            "lines": [
              "Fifteen days left on the pool",
              "and everything but the exam hall",
              "closes. Plan for it."
            ],
            "emotion": "strict"
          },
          {
            "chain_id": "praise",
            "lines": [
              "Three for three on the paper.",
              "That is ten days, not fourteen."
            ],
            "emotion": "approving"
          }
        ],
        "on_complete": "loop_last"
      }
    },
    {
      "uid": "npc_0002",
