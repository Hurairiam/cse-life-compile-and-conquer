            "chain_id": "tip",
            "lines": [
              "Two days for a sprint,",
              "or four thousand if you are rich.",
              "Same ten EXP either way."
            ],
            "emotion": "neutral"
          },
          {
            "chain_id": "worry",
            "lines": [
              "Backlogs do not disappear.",
