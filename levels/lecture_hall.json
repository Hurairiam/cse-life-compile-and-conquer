  "npcs": [
    {
      "uid": "npc_0001",
      "type_id": "hoque",
      "x": 12,
      "y": 5,
      "facing": "down",
      "interactable": true,
      "dialog": {
        "chains": [
          {
            "chain_id": "greeting",
            "lines": [
              "You are registered in my course.",
              "I am Prof. Hoque. I do not repeat instructions.",
              "Come prepared. Every single time."
            ],
            "emotion": "neutral"
          },
          {
            "chain_id": "offer",
            "lines": [
              "There is an activity this week.",
              "It will be difficult. That is the point.",
              "If you are serious about this field \u2014 show up."
            ],
            "emotion": "neutral"
          },
          {
            "chain_id": "farewell",
            "lines": [
              "Your choice. The work still needs to be done."
            ],
            "emotion": "neutral"
          }
        ],
        "on_complete": "loop_last"
      }
    },
    {
      "uid": "npc_0002",
      "type_id": "rahman",
      "x": 8,
      "y": 5,
      "facing": "down",
      "interactable": true,
      "dialog": {
        "chains": [
          {
            "chain_id": "greeting",
            "lines": [
              "Ah, a student who actually comes to office hours.",
              "Prof. Rahman here. Sit down \u2014 I don't bite.",
              "Tell me what you're struggling with. That's what I'm here for."
            ],
            "emotion": "neutral"
          },
          {
            "chain_id": "offer",
            "lines": [
              "There is a study group forming this week.",
              "I think it would help you. A few days of focused work.",
              "Think about it."
            ],
            "emotion": "neutral"
          },
          {
            "chain_id": "farewell",
            "lines": [
              "My door is open. Remember that."
            ],
            "emotion": "neutral"
          }
        ],
        "on_complete": "loop_last"
      }
    }
  ],
